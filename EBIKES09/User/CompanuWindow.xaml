<Page x:Class="EBIKES09.CompanuPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBIKES09"
        mc:Ignorable="d"
        Title="CompanuWindow" >
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF0E263F" />
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="#E8E8E8" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>



            <TextBlock Text="О компании!" FontWeight="Bold" FontSize="45" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Margin="10,10,10,50" Grid.Row="1"  Grid.Column="0" Grid.ColumnSpan="2" Text="E-BikeS – в городе Екатеринбург магазин надежного электротранспорта и качественной электроники.
Больше чем технику, мы любим только инновационную технику. С каждой новинкой, поражающей воображение, с каждым новым аксессуаром, делающим жизнь проще и ярче, эта любовь всё больше крепнет. Мы делимся ей с вами и постоянно обновляем ассортимент


электровелосипедов и аккумуляторов. Мы работаем напрямую с лучшими производителями и гордимся сотрудничеством с Halten, Xiaomi, White Siberia, Kugoo, GT, Minako, Sygwey. 

Мы не хотим стать «еще одним интернет-магазином», поэтому в самом начале пути (2014-м году) сформулировали принципs работы, которые сделали нас теми, кто мы есть." TextWrapping="Wrap"></TextBlock>
            <Image Source="C:\Users\Игорь\source\repos\EBIKES09\EBIKES09\Image\Store.jpg" MinWidth="300" MaxHeight="400" Height="auto" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Margin="10, 10, 10, 50" Stretch="Uniform"/>
            <TextBlock Margin="10" Grid.Row="2" TextWrapping="Wrap" Grid.Column="1" Grid.ColumnSpan="3"  VerticalAlignment="Top" Text="Качество всегда решает.
Мы никогда не продавали подделки (даже хорошие), мы не стремимся «нагреться» на покупателях за счет экономии и мы создаем условия для того, чтобы клиенты всегда могли убедиться в качестве. В 12 городах работают наши точки офлайн-продаж, куда вы всегда можете заглянуть и протестировать любой товар. В случае любых возникших проблем, мы исправим ситуацию, чего бы нам это не стоило. Мы гордимся тем, что за всё время у нас не было недовольных клиентов. Мы открыты, всегда реагируем на отзывы и ставим перед собой большие цели."/>
            <Image Source="C:\Users\Игорь\source\repos\EBIKES09\EBIKES09\Image\betary.png" MinWidth="300" MaxHeight="400"  VerticalAlignment="Center"  Grid.Row="2" Grid.Column="0" />
        </Grid>

    </ScrollViewer>
</Page>
