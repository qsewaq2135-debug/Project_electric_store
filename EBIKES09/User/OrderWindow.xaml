<Page x:Class="EBIKES09.OrderPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBIKES09"
        mc:Ignorable="d"
        Title="OrderWindow" >
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2c3e50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#34495e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>

            <Setter Property="Template">

                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
           BorderBrush="{TemplateBinding BorderBrush}" 
           BorderThickness="{TemplateBinding BorderThickness}"
           CornerRadius="5"
           >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
        </Style>
        <Style TargetType="TextBlock">

            <Setter Property="Foreground" Value="#0e263f" />
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>

        </Style>
        <Style TargetType="TextBox">

            <Setter Property="Foreground" Value="#0e263f" />
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>

        </Style>
        <Style TargetType="ComboBox">

            <Setter Property="Foreground" Value="#0e263f" />
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>

        </Style>
        <Style TargetType="CheckBox">

            <Setter Property="Foreground" Value="#0e263f" />
            <Setter Property="FontSize" Value="20"/>
                        <Setter Property="FontFamily" Value="Comic Sans MS"/>

        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderTextBlock">
            <Setter Property="Foreground" Value="#0e263f" />
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Page.Resources>
    <Grid Background="#E8E8E8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
              
            <StackPanel x:Name="StackGUID" Orientation="Horizontal" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Visibility="Collapsed" HorizontalAlignment="Center"  Margin="0,35,0,0">
            <Image Source="Image/information.png" Width="32" Height="32" Margin="10,0,10,0" >
                <Image.ToolTip>
                    <ToolTip>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Height="auto" Width="200" Text="Укажите ваш уникальный идентификатор (GUID), если у вас уже есть заказ у нас. Это поможет нам быстрее найти ваши данные и упростит оформление нового заказа. Не знаете свой GUID? (Посмотрите в письме с подтверждением вашего предыдущего заказа. В БУДУЩЕМ НАДО РЕАЛИЗОВАТЬ!!)" FontWeight="Bold"/>
                        
                    </ToolTip>
                </Image.ToolTip>
            </Image>
            <TextBlock Text="Ваш GUID: "></TextBlock>
                <TextBox x:Name="GuidBox"  Width="300" ></TextBox>
            <Button Click="ButtonGuid_Click" Content="Найти" Width="100"></Button>
            </StackPanel>


        <ScrollViewer Grid.ColumnSpan="2" Grid.Row="1">
            <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center" Grid.Row="1">
                <TextBlock Text="Имя: "  Margin="10,10,10,0"/>
                <TextBox x:Name="FirstName_box" Margin="10,0,10,0"/>
                <TextBlock Text="Фамилия: " Margin="10,10,10,0"/>
                <TextBox x:Name="LastName_box" Margin="10,0,10,0"/>
                <TextBlock Text="Номер телефона:" Margin="10,10,10,0"/>
                <TextBox x:Name="TelNo_Box" Margin="10,0,10,0"/>
                <TextBlock Text="Email" Margin="10,10,10,0"/>
                <TextBox x:Name="Email_box" Margin="10,0,10,0"/>
                <TextBlock Text="Способ оплаты: " Margin="10,10,10,0"/>
                <ComboBox IsEnabled="True" Text="Выберите способ оплаты" IsReadOnly="True" x:Name="ComboBoxPay" Margin="10,0,10,0"/>
                <TextBlock Text="Коментарий: " Margin="10,10,10,0"/>
                <TextBox x:Name="description" AcceptsReturn="True" AcceptsTab="True"  Margin="10,0,10,20"/>
                <CheckBox x:Name="check" Checked="CheckedPersonal" Unchecked="UnCheckedPersonal" Margin="10,0,10,10" >
                    <Hyperlink Click="PrivacyPolicyLink_Click">
                        Согласие на обработку персональных данных
                    </Hyperlink>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>
        
        
        <Button Click="ButtonEnter_Click" Visibility="Hidden" x:Name="ButtonEnter" Content="Оформить" Grid.Column="1" Grid.Row="2"  Height="50" Width="200" Margin="10"/>
    </Grid>
</Page>
