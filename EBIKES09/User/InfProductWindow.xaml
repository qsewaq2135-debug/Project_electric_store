<Page x:Class="EBIKES09.InfProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:EBIKES09"
      mc:Ignorable="d"
      Title="InfProductPage" 
      Background="#F5F5F5">

    <Page.Resources>
        <local:StockToVisibilityConverter x:Key="StockToVisibilityConverter"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0E263F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" Color="#40000000" Opacity="0.5" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстовых блоков -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0E263F"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Стиль для заголовков -->
        <Style x:Key="HeaderTextBlock" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0E263F"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Background="#E8E8E8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с логотипом и корзиной -->
       

        <!-- Боковая панель с кнопкой редактирования -->
        <StackPanel Orientation="Vertical" MinHeight="100" MinWidth="200" Grid.Row="1" Grid.RowSpan="4" Grid.Column="0" Background="#E8E8E8" Margin="10">
            <Button Content="Редактирование товара" x:Name="EditeButton" Click="ButtonEdit_click" Style="{StaticResource CustomButtonStyle}" Visibility="Collapsed" Margin="10"/>
        </StackPanel>

        <!-- Основная информация о товаре -->
        <DockPanel x:Name="dock" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="10">
            <StackPanel DockPanel.Dock="Left">
                <Viewbox MinHeight="200" MinWidth="250" MaxHeight="400" MaxWidth="500" Stretch="Uniform">
                    <Image Source="{Binding ImageUrl}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30"/>
                </Viewbox>
            </StackPanel>
            <StackPanel Margin="30,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DiscountedPriceTextBlock" Margin="0,5,0,0"  FontWeight="Bold"/>
                        <TextBlock x:Name="Price_box" Text="{Binding Price, StringFormat='{}{0}₽'}"  VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProductName_box" Text="{Binding ProductName}" Style="{StaticResource HeaderTextBlock}"/>
                    <TextBlock Text="Нет оценок" Visibility="Collapsed" x:Name="NoStar" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Image Source="image/star1.png" x:Name="Star_1" Visibility="Collapsed" Height="32" Stretch="Uniform" Margin="20 0 0 0"/>
                    <Image Source="image/star2.png" x:Name="Star_2" Visibility="Collapsed" Height="32" Stretch="Uniform"/>
                    <Image Source="image/star3.png" x:Name="Star_3" Visibility="Collapsed" Height="32" Stretch="Uniform"/>
                        <Image Source="Image\star4.png" x:Name="Star_4" Visibility="Collapsed" Height="32" Stretch="Uniform"/>
                    <Image Source="image/star5.png" x:Name="Star_5" Visibility="Collapsed" Height="32" Stretch="Uniform"/>
                </StackPanel>
                <TextBlock x:Name="PromotionInfoTextBlock" Text="Нет действующих акций." Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Добавить в корзину" x:Name="ButtonAddBasket" HorizontalAlignment="Left" Height="25" MinWidth="150" MaxWidth="350" Click="ButtonAddBasket_click" Margin="5" Style="{StaticResource CustomButtonStyle}"/>
                    <Button Content="Отзывы" x:Name="ButtonReview" Click="ButtonReview_click" Height="25" MinWidth="150" MaxWidth="350" Margin="5" HorizontalAlignment="Left" Style="{StaticResource CustomButtonStyle}"/>
                    <TextBlock Text="Нет в наличии" Foreground="Red" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                               Visibility="{Binding StockQuantity, Converter={StaticResource StockToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Описание:" Style="{StaticResource HeaderTextBlock}"/>
                    <Image x:Name="DiscountIcon" Source="image/sale.png" Height="36" Width="36" Margin="5,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource HeaderTextBlock}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Характеристики товара -->
        <TextBlock Grid.Row="2" Grid.Column="1" Text="Характеристики:" Style="{StaticResource HeaderTextBlock}"/>
        <StackPanel Margin="10,0,0,10" Grid.Row="3" Grid.Column="1" x:Name="StackPanelB1">
            <TextBlock Text="{Binding BatteryCharacteristic.Voltage.VoltageName, StringFormat='Напряжение: {0} V'}"/>
            <TextBlock Text="{Binding BatteryCharacteristic.NominalCapacity, StringFormat='Eмкость: {0} Ah'}"/>
            <TextBlock Text="{Binding BatteryCharacteristic.BatteryType.BatteryType1, StringFormat='Тип аккмулятора: {0} '}"/>
            <TextBlock Text="{Binding BatteryCharacteristic.ServiceLife, StringFormat='Срок службы: {0} года'}"/>
        </StackPanel>
        <StackPanel Margin="10,0,0,10" Grid.Row="3" Grid.Column="1" x:Name="StackPanelE1">
            <TextBlock Text="{Binding BikeCharacteristic.MaximumSpeed, StringFormat='Максимальная скорость: {0} км/ч'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.MaximumRange, StringFormat='Максимальный пробег: {0} км'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.MaxLoad, StringFormat='Максимальная нагрузка: {0} кг'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.MotorPower, StringFormat='Мощность мотора: {0} Вт'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.Drive.DriveName, StringFormat='Тип привода: {0}'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.Voltage, StringFormat='Напряжение: {0} В'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.Capacity, StringFormat='Емкость: {0} Ач'}"/>
        </StackPanel>
        <StackPanel Margin="10,0,0,10" Grid.Row="3" Grid.Column="2" x:Name="StackPanelE2">
            <TextBlock Text="{Binding BikeCharacteristic.FullChargeTime, StringFormat='Время полной зарядки: {0} ч'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.WheelDiameter, StringFormat='Диаметр колес: {0} дюймы'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.NumberOfSpeeds, StringFormat='Количество скоростей: {0}'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.Weight, StringFormat='Вес: {0} кг'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.FrontBrakes.FrontBrakesName, StringFormat='Передние тормоза: {0}'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.RearBrakes.RearBrakesName, StringFormat='Задние тормоза: {0}'}"/>
            <TextBlock Text="{Binding BikeCharacteristic.FrameMaterial.FrameMaterialName, StringFormat='Материал рамы: {0}'}"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>