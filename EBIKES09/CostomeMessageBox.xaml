<Window x:Class="EBIKES09.CostomeMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBIKES09"
        mc:Ignorable="d"
        Title="CostomeMessageBox" Height="220" Width="400"  ResizeMode="NoResize"   >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="5"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{Binding Message}"
                   />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="CopyButton" Content="Копировать" Click="CopyButton_Click" Margin="0,0,5,0"
                    Visibility="{Binding ShowCopyButton, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button x:Name="OkButton" Content="OK" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
