<Page x:Class="EBIKES09.LoadingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoadingWindow" 
        
        Background="Transparent" 
        
        Width="400" 
        Height="300">
    <Page.Resources>
        <!-- Анимация для вращения -->
        <Storyboard x:Key="RotateAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:2"/>
        </Storyboard>

        <!-- Анимация для плавного закрытия -->
        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>

        <!-- Анимация для плавного открытия -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Фон с закругленными углами -->
        <Border Background="#FF0E263F" CornerRadius="20" Opacity="0.9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <!-- Контент -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Анимированный логотип -->
            <Image x:Name="LoadingImage" Source="loading_icon.png" Width="80" Height="80" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Image.RenderTransform>
            </Image>

            <!-- Текст загрузки -->
            <TextBlock x:Name="LoadingText" Text="Загрузка..." Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <!-- Кастомный прогресс-бар -->
            <Border x:Name="ProgressBarBackground" Width="200" Height="10" Background="#444444" CornerRadius="5" Margin="0,20,0,0">
                <Border x:Name="ProgressBarFill" Width="0" Height="10" Background="#FF00A8E8" CornerRadius="5" HorizontalAlignment="Left"/>
            </Border>

            <!-- Текст с прогрессом -->
            <TextBlock x:Name="ProgressText" Text="0%" Foreground="White" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>