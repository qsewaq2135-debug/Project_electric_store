<Page x:Class="EBIKES09.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="AddUserPage" 
      Background="#1e2b38">
    <Page.Resources>
        <!-- Стиль для текстовых блоков -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0E263F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" Color="#40000000" Opacity="0.5" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TextBox -->
        <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#293a49"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4a6073"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style  TargetType="PasswordBox">
            <Setter Property="Background" Value="#293a49"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4a6073"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <!-- Стиль для ListBox -->
        <Style x:Key="CustomListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#293a49"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Стиль для элементов ListBox -->
        <Style x:Key="CustomListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#4a6073"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#4a6073"/>
            <Setter Property="BorderThickness" Value="1"/>

        </Style>
    </Page.Resources>

    <Grid Background="#1e2b38">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Добавить нового пользователя" FontSize="20" Foreground="White" Margin="10" />
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Имя:"/>
                <TextBox x:Name="FirstNameTextBox" Style="{StaticResource CustomTextBoxStyle}"  />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Фамилия:"/>
                <TextBox x:Name="LastNameTextBox" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,10" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Email:"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource CustomTextBoxStyle}"  Margin="0,0,0,10" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Номер телефона:"/>
                <TextBox x:Name="PhoneNumberTextBox" Style="{StaticResource CustomTextBoxStyle}"  Margin="0,0,0,10" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Логин:"/>
                <TextBox x:Name="LoginTextBox" Style="{StaticResource CustomTextBoxStyle}"  Margin="0,0,0,10" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Пароль:"/>
                <TextBox x:Name="PasswordTextBox" Style="{StaticResource CustomTextBoxStyle}" Margin="0,0,0,10" />
            </StackPanel>


            <Button Content="Сохранить" Click="ButtonSave_Click" Margin="10" Style="{StaticResource CustomButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>