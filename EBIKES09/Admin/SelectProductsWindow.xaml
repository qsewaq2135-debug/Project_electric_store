<Page x:Class="EBIKES09.SelectProductsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Выбор товаров для акции" 
        Background="#1e2b38">
    <Grid>
        <DataGrid MinHeight="200" MaxHeight="1000" x:Name="ProductsDataGrid" AutoGenerateColumns="False" SelectionMode="Extended" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Width="*" Binding="{Binding ProductName}" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" />
                <DataGridCheckBoxColumn Header="Выбрать" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Сохранить" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Bottom" Click="ButtonSaveProducts_Click" />
    </Grid>
</Page>