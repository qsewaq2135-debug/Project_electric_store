<Page x:Class="EBIKES09.UserInfoPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EBIKES09"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Информация о пользователе" 
        Background="#1e2b38">

    <Page.Resources>
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0E263F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" Color="#40000000" Opacity="0.5" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Информация о пользователе" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Margin="20" Foreground="White" />

        <!-- Информация о пользователе -->
        <StackPanel Grid.Row="1" Margin="20">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Имя:" Width="120" Foreground="White" />
                <TextBlock x:Name="FirstNameTextBlock" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Фамилия:" Width="120" Foreground="White" />
                <TextBlock x:Name="LastNameTextBlock" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Email:" Width="120" Foreground="White" />
                <TextBlock x:Name="EmailTextBlock" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Телефон:" Width="120" Foreground="White" />
                <TextBlock x:Name="PhoneNumberTextBlock" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Логин:" Width="120" Foreground="White" />
                <TextBlock x:Name="LoginTextBlock" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Пароль:" Width="120" Foreground="White" />
                <TextBlock x:Name="PasswordTextBlock" Foreground="White" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Редактировать" Height="30" Width="150" Style="{StaticResource CustomButtonStyle}" Click="ButtonEdit_click"  Margin="10" />
            <Button Content="Удалять" Height="30" Width="150" Style="{StaticResource CustomButtonStyle}" Margin="10"  />
        </StackPanel>
    </Grid>
</Page>